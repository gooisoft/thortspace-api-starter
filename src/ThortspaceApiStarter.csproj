<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows-only: the Thortspace engine targets net8.0-windows (build with any newer SDK; RollForward
         lets the exe run on newer runtimes). -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ThortspaceApiStarter</RootNamespace>
    <AssemblyName>ThortspaceApiStarter</AssemblyName>
    <RollForward>Major</RollForward>
    <!-- The engine references WinForms types on some (non-headless) paths; keep the desktop framework
         available so a stray load can never fail at runtime. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Thortspace headless SDK — the engine DLL + its dependency closure, restored from nuget.org
         like any other package. This IS the API; no installed Thortspace app is needed. -->
    <PackageReference Include="Thortspace.Headless" Version="1.6.727" />
  </ItemGroup>

</Project>

